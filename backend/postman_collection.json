  "item": [
    {
      "name": "1. Create expense — valid data (201)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const today = new Date().toISOString().split('T')[0];",
              "pm.collectionVariables.set('todayDate', today);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response contains created expense fields', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData.title).to.eql('Lunch');",
              "    pm.expect(Number(jsonData.amount)).to.eql(120);",
              "    pm.expect(jsonData.category).to.eql('Food');",
              "    pm.expect(jsonData.payment_method).to.eql('UPI');",
              "    pm.collectionVariables.set('expenseId', jsonData.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Lunch\",\n  \"amount\": \"120.00\",\n  \"category\": \"Food\",\n  \"date\": \"{{todayDate}}\",\n  \"payment_method\": \"UPI\",\n  \"description\": \"Afternoon lunch at restaurant\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            ""
          ]
        },
        "description": "Creates a new expense using valid payload data. Automatically sets collection variable `expenseId` to the returned ID."
      },
      "response": []
    },
